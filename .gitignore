# Virtual environments
venv/
.venv/
env/
.env/

# Environment files (the .env/ above only matches a directory)
.env
.env.*

# Build artifacts
build/
dist/
*.spec
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# PyInstaller
*.manifest
*.spec

# Distribution / packaging
.eggs/
*.egg-info/
*.egg
MANIFEST

# Config files with credentials (never commit these!)
npm-api.conf
*.conf
!npm-api.conf.example

# Token and data files
data/
token/
backups/
*.txt
!requirements.txt
!requirements-*.txt

# Certificate material. `cert download` defaults to ./certificates and writes
# a private key there, so never let one be staged from inside a clone.
certificates/
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Scratch suites from a QA sweep: one deliberately failing test per finding
# that has not been fixed yet, kept beside the code while it is worked
# through. They are working notes, not coverage — anything worth keeping is
# rewritten into test_npm_api.py, which is the suite that must always pass.
# Ignored so a stray `git add -A` cannot publish a pile of red tests.
test_qa_*.py

# Patch bundles carried between machines by hand. The sandbox that writes
# them cannot reach GitHub, so commits travel as `git format-patch` output
# and land here to be applied; they are a transport, never content.
mbox/

# Logs
*.log
