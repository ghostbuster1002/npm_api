# Virtual environments
venv/
.venv/
env/
.env/

# Environment files (the .env/ above only matches a directory)
.env
.env.*

# Build artifacts
build/
dist/
*.spec
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# PyInstaller
*.manifest
*.spec

# Distribution / packaging
.eggs/
*.egg-info/
*.egg
MANIFEST

# Config files with credentials (never commit these!)
npm-api.conf
*.conf
!npm-api.conf.example

# Token and data files
data/
token/
backups/
*.txt
!requirements.txt
!requirements-*.txt

# Certificate material. `cert download` defaults to ./certificates and writes
# a private key there, so never let one be staged from inside a clone.
certificates/
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs
*.log
